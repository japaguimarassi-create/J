KLOD_CHECKPOINT_PATH=artifacts/checkpoints/latest.pt
KLOD_TOKENIZER_PATH=artifacts/tokenizer.json
KLOD_CORS_ORIGINS=https://your-klod-app.example
DATABASE_URL=postgresql://user:password@host:5432/klod
KLOD_APP_URL=https://your-klod-app.example
KLOD_OWNER_EMAIL=owner@example.com
KLOD_SMTP_HOST=smtp.example.com
KLOD_SMTP_PORT=587
KLOD_SMTP_USERNAME=replace-with-smtp-username
KLOD_SMTP_PASSWORD=replace-with-smtp-password
KLOD_SMTP_FROM=Klod <no-reply@example.com>
KLOD_SMTP_SSL=false
KLOD_SMTP_STARTTLS=true
KLOD_SESSION_COOKIE_SECURE=true
KLOD_SESSION_COOKIE_NAME=klod_session
KLOD_COOKIE_SAMESITE=lax
